# Copy to .env.local for local dev, and add the same three to Vercel →
# Settings → Environment Variables. Until they exist the site runs entirely on
# mock data — nothing breaks, nothing persists.

# Supabase → Project Settings → Data API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase → Project Settings → API Keys → service_role
# SERVER ONLY. Never prefix this with NEXT_PUBLIC_ — it bypasses row level
# security and would hand anyone with devtools full write access to the ledger.
SUPABASE_SERVICE_ROLE_KEY=

# Any random 32+ character string. Signs the session cookie so a profile id
# can't be forged. Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# ── optional, but strongly recommended before real users ──────────────────

# Cloudflare Turnstile (free). While this is unset the captcha checkbox is
# decorative and the server logs a warning on every submit.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Protects /api/cron/keepalive. Vercel sends it as a Bearer token on scheduled
# runs. Any random string.
# CRON_SECRET=

# Canonical origin, no trailing slash, e.g. https://squibsociety.xyz
# Set this once you have a custom domain. It fixes the X redirect_uri to one
# value, so visitors arriving on www and on the apex both work with a single
# registered callback URL.
# APP_URL=

# Password for /admin. Unset means nobody gets in, which is the right default
# for a page that lists wallet addresses. Set it in Vercel, never in the repo.
# ADMIN_PASSWORD=
